---
// Grote aanvraagkaart zoals bij ZBN: donker paneel met uitleg links, formulier rechts.
import Icoon from './Icoon.astro';
import VraagFormulier from './VraagFormulier.astro';
import { zaak } from '../lib/site';
interface Props { bron: string }
const { bron } = Astro.props;
---
<section id="vraag" class="wrap py-12 sm:py-20 lg:py-28" aria-labelledby="vraag-kop">
  <div class="grid overflow-hidden rounded-[24px] bg-wit shadow-hoog ring-1 ring-lijn lg:grid-cols-12">
    <div class="donker bg-nacht p-8 text-mist sm:p-10 lg:col-span-5 lg:p-12">
      <p class="kicker text-saffraan">Vraag het Klaas</p>
      <h2 id="vraag-kop" class="mt-4 text-4xl text-wit">Vertel Klaas wat je zoekt.</h2>
      <p class="mt-5 text-lg">Neem gerust contact op met Klaas, als je vragen hebt over jouw droomkast.</p>
      <ul class="mt-6 space-y-2 text-sm">
        <li class="flex gap-2.5"><Icoon naam="vink" class="mt-0.5 h-4 w-4 flex-none text-saffraan" />Elke kast is een uniek exemplaar uit India</li>
        <li class="flex gap-2.5"><Icoon naam="vink" class="mt-0.5 h-4 w-4 flex-none text-saffraan" />Kom kijken in de winkel, ook op afspraak</li>
        <li class="flex gap-2.5"><Icoon naam="vink" class="mt-0.5 h-4 w-4 flex-none text-saffraan" />Tegen een vergoeding worden de kasten thuis bezorgd</li>
      </ul>
      <ol class="mt-8 space-y-4 text-[.95rem]">
        {['Je stuurt je vraag, Klaas krijgt hem direct in de mail.', 'Klaas belt of mailt je terug.', 'Je komt kijken op de Kaasmarkt, of spreekt af hoe de kast bij je komt.'].map((t, i) => (
          <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-wit/10 text-sm font-semibold text-wit">{i + 1}</span><span>{t}</span></li>
        ))}
      </ol>
      <p class="mt-10 text-sm">Liever direct bellen?</p>
      <a href={zaak.telefoonLink} class="mt-1 inline-block font-kop text-3xl font-bold text-wit no-underline [font-stretch:110%] hover:text-saffraan" data-goatcounter-click={`bel-${bron}`}>{zaak.telefoon}</a>
    </div>
    <div class="p-6 sm:p-10 lg:col-span-7 lg:p-12">
      <VraagFormulier bron={bron} />
    </div>
  </div>
</section>
