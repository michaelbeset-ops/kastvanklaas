---
// Het eigen logo van Klaas (bron/img/2016_03_logo-1.png, 412x55).
import { type Taal, lp } from '../lib/i18n';
interface Props { licht?: boolean; compact?: boolean; taal?: Taal }
const { compact = false, taal = 'nl' } = Astro.props;
---
<a href={lp(taal, '/')} class="inline-flex items-center no-underline">
  <img src="/logo-kastvanklaas.png" width="412" height="55" alt="Kast van Klaas" class:list={['block w-auto', compact ? 'h-7 sm:h-8' : 'h-8 sm:h-9']} />
</a>
