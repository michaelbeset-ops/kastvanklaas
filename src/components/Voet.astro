---
import Merk from './Merk.astro';
import { zaak, tijden } from '../lib/site';
import { type Taal, UI, lp, tijdvak } from '../lib/i18n';
interface Props { taal?: Taal }
const { taal = 'nl' } = Astro.props;
const u = UI[taal];
const v = u.voet;
---
<!-- Donker, net als header en hero: de site begint en eindigt in dezelfde kleur. -->
<footer class="donker bg-nacht text-mist">
  <div class="wrap grid gap-10 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <Merk taal={taal} />
      <p class="mt-6 max-w-xs text-sm">{v.merk}</p>
    </div>
    <div class="text-sm md:col-span-3">
      <h2 class="font-tekst text-sm font-semibold tracking-normal text-wit">{v.winkel}</h2>
      <p class="mt-3">{zaak.straat}<br />{zaak.postcode} {zaak.plaats}{taal !== 'nl' && <><br />{taal === 'de' ? 'Niederlande' : 'The Netherlands'}</>}</p>
      <p class="mt-3"><a class="text-wit underline decoration-saffraan underline-offset-4 hover:text-saffraan" href={zaak.telefoonLink} data-goatcounter-click="bel-voet">{taal === 'nl' ? zaak.telefoon : '+31 6 26 37 84 80'}</a><br /><a class="text-wit underline decoration-saffraan underline-offset-4 hover:text-saffraan" href={`mailto:${zaak.email}`}>{zaak.email}</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <h2 class="font-tekst text-sm font-semibold tracking-normal text-wit">{v.open}</h2>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 tabular-nums">
        {tijden.map((t, i) => (<><dt>{u.dagen[i]}</dt><dd>{tijdvak(t.open, t.dicht, taal, false)}</dd></>))}
      </dl>
      <p class="mt-2">{v.ofAfspraak}</p>
    </div>
    <div class="text-sm md:col-span-2">
      <h2 class="font-tekst text-sm font-semibold tracking-normal text-wit">{v.collectie}</h2>
      <ul class="mt-3 space-y-1">
        <li><a class="no-underline hover:text-saffraan" href={lp(taal, '/webshop/cat/india-kasten/')}>{v.indiaKasten}</a></li>
        <li><a class="no-underline hover:text-saffraan" href={lp(taal, '/meer-bij-kastvanklaas/')}>{v.meer}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-wit/10">
    <div class="wrap flex flex-wrap gap-x-6 gap-y-2 py-5 text-xs">
      <span>KvK {zaak.kvk}</span>
      <a class="no-underline hover:text-saffraan" href={lp(taal, '/privacy/')}>{v.privacy}</a>
      <a class="no-underline hover:text-saffraan" href={lp(taal, '/algemene-voorwaarden/')}>{v.voorwaarden}</a>
      <span class="sm:ml-auto">{v.door} <a class="text-wit no-underline hover:text-saffraan" href="https://sitefront.nl" rel="noopener">Sitefront</a></span>
    </div>
  </div>
</footer>
