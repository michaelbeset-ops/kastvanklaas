---
// Reviews van Google, letterlijk (bron/google/reviews-alle.json). Horizontaal te swipen, met pijlen op desktop.
import Icoon from './Icoon.astro';
import { zaak, reviews } from '../lib/site';
---
<section class="bg-ijs py-12 sm:py-20 lg:py-28" aria-labelledby="reviews-kop">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="kicker text-stil">Reviews</p>
        <h2 id="reviews-kop" class="mt-3 text-4xl">Wat klanten zeggen.</h2>
      </div>
      <div class="flex items-center gap-4">
        <a href={zaak.google.link} rel="noopener" class="flex items-center gap-2 text-sm text-inkt no-underline hover:underline">
          <span class="flex text-saffraan" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
          <b>{zaak.google.score}</b> uit 5 op Google, {zaak.google.aantal} reviews
        </a>
        <div class="hidden gap-2 sm:flex">
          <button type="button" class="grid h-10 w-10 place-items-center rounded-full bg-wit shadow-zacht ring-1 ring-lijn hover:bg-ijs" data-rij-terug aria-label="Vorige review"><Icoon naam="pijl-links" class="h-4 w-4" /></button>
          <button type="button" class="grid h-10 w-10 place-items-center rounded-full bg-wit shadow-zacht ring-1 ring-lijn hover:bg-ijs" data-rij-verder aria-label="Volgende review"><Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </div>
    </div>
    <ul class="rij mt-10" data-rij>
      {reviews.map((r) => (
        <li class="kaart flex flex-col p-6">
          <span class="flex text-saffraan" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
          <blockquote class="mt-4 flex-1 text-[.98rem] leading-relaxed text-inkt">{r.tekst}</blockquote>
          <p class="mt-6 text-sm font-semibold text-inkt">{r.naam}</p>
          <p class="text-xs text-stil">Google</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  const rij = document.querySelector<HTMLElement>('[data-rij]');
  const stap = () => (rij?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 300;
  document.querySelector('[data-rij-terug]')?.addEventListener('click', () => rij?.scrollBy({ left: -stap() - 16, behavior: 'smooth' }));
  document.querySelector('[data-rij-verder]')?.addEventListener('click', () => rij?.scrollBy({ left: stap() + 16, behavior: 'smooth' }));
</script>
