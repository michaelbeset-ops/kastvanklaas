---
import { Picture } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import PaginaKop from '../components/PaginaKop.astro';
import KastKaart from '../components/KastKaart.astro';
import { alleKasten, kruimelSchema } from '../lib/kasten';
import { type Taal, UI, lp } from '../lib/i18n';
import kikker from '../assets/site/kikker.jpg';
// Klein houden (afspraak met Michael): "Ook in de winkel". Titel en beeld komen van de oude JoosjeDoodles-pagina's.
interface Props { taal: Taal }
const { taal } = Astro.props;
const werk = (await alleKasten(taal)).filter((k) => k.categorie === 'joosjedoodles' && !/kast|tafel|kookeiland|lamp|rek/i.test(k.naam));
const T = {
  nl: { titel: 'Joosje Doodles, illustratie en ontwerp | Kast van Klaas Leiden', beschrijving: 'Ook in de winkel van Kast van Klaas op de Kaasmarkt in Leiden: illustratie en ontwerp van JoosjeDoodles.',
    h1: 'Illustratie en ontwerp JoosjeDoodles', intro: 'Ook in de winkel op de Kaasmarkt.', alt: 'Illustratie van JoosjeDoodles: een kikker die uitrust onder een grote madelief', kop: 'In de winkel', alles: 'Alles van Joosje Doodles' },
  de: { titel: 'Joosje Doodles, Illustration und Design | Kast van Klaas', beschrijving: 'Auch im Laden von Kast van Klaas am Kaasmarkt in Leiden: Illustration und Design von JoosjeDoodles.',
    h1: 'Illustration und Design von JoosjeDoodles', intro: 'Auch im Laden am Kaasmarkt.', alt: 'Illustration von JoosjeDoodles: ein Frosch, der unter einem großen Gänseblümchen ausruht', kop: 'Im Laden', alles: 'Alles von Joosje Doodles' },
  en: { titel: 'Joosje Doodles, illustration and design | Kast van Klaas', beschrijving: 'Also in the Kast van Klaas shop on the Kaasmarkt in Leiden: illustration and design by JoosjeDoodles.',
    h1: 'Illustration and design by JoosjeDoodles', intro: 'Also in the shop on the Kaasmarkt.', alt: 'Illustration by JoosjeDoodles: a frog resting under a large daisy', kop: 'In the shop', alles: 'All of Joosje Doodles' },
}[taal];
---
<Basis titel={T.titel} beschrijving={T.beschrijving} pad="/joosjedoodles/" taal={taal}
  schema={[kruimelSchema([{ naam: UI[taal].home, pad: lp(taal, '/') }, { naam: 'Joosje Doodles', pad: lp(taal, '/joosjedoodles/') }])]}>
  <PaginaKop kruimel="Joosje Doodles" titel={T.h1} intro={T.intro} taal={taal} />
  <section class="wrap mt-14 grid gap-10 md:grid-cols-12 md:gap-14">
    <figure class="md:col-span-4">
      <Picture src={kikker} alt={T.alt} formats={['avif']} fallbackFormat="webp" widths={[400, 700]}
        sizes="(min-width: 768px) 32vw, 100vw" quality={78} loading="eager" class="h-auto w-full rounded-[24px]" />
    </figure>
    <div class="md:col-span-7 md:col-start-6">
      <h2 class="text-2xl sm:text-3xl">{T.kop}</h2>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3">
        {werk.map((k) => <KastKaart kast={k} />)}
      </ul>
      <p class="mt-10"><a class="link" href={lp(taal, '/webshop/cat/joosjedoodles/')}>{T.alles}</a></p>
    </div>
  </section>
</Basis>
