  </section>

  <!-- Klaas: donker, zijn eigen verhaal van de huidige site. -->
  <section class="donker bg-nacht py-14 text-mist sm:py-20 lg:py-28" aria-labelledby="klaas">
    <div class="wrap grid gap-12 md:grid-cols-12 md:items-center">
      <figure class="md:col-span-6">
        <Picture src={klaasIndia} alt={T.klaasAlt} formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw" quality={70} class="aspect-[4/3] w-full rounded-[24px] object-cover object-[60%_30%]" />
      </figure>
      <div class="md:col-span-6 lg:col-span-5 lg:col-start-8">
        <p class="kicker text-saffraan">{T.overKicker}</p>
        <h2 id="klaas" class="mt-3 text-4xl text-wit">{T.overKop[0]}<span class="sier text-saffraan">{T.overKop[1]}</span>{T.overKop[2]}</h2>
        <div class="mt-6 space-y-4 text-[1.05rem] leading-relaxed">
          {T.over.map((p) => <p>{p}</p>)}
        </div>
        <a href={lp(taal, '/over-kast-van-klaas/')} class="knop knop-glas mt-8">{T.meerOver}<Icoon naam="pijl" /></a>
      </div>
    </div>
    <!-- Strook uit India: eigen foto's van de huidige site. -->
    <div class="wrap mt-14 grid grid-cols-2 gap-3 sm:mt-20 sm:grid-cols-12 sm:gap-4">
      <div class="col-span-2 sm:col-span-6">
        <Picture src={indiaWerkplaats} alt={T.stripAlt[0]} formats={['avif']} fallbackFormat="webp" widths={[480, 960]}
          sizes="(min-width: 640px) 50vw, 100vw" quality={64} loading="lazy" class="aspect-[4/3] h-full w-full rounded-[18px] object-cover" />
      </div>
      <div class="sm:col-span-3">
        <Picture src={indiaDeuren} alt={T.stripAlt[1]} formats={['avif']} fallbackFormat="webp" widths={[400, 800]}
          sizes="(min-width: 640px) 25vw, 50vw" quality={64} loading="lazy" class="aspect-[3/4] h-full w-full rounded-[18px] object-cover" />
      </div>
      <div class="sm:col-span-3">
        <Picture src={indiaBlikjes} alt={T.stripAlt[2]} formats={['avif']} fallbackFormat="webp" widths={[400, 800]}
          sizes="(min-width: 640px) 25vw, 50vw" quality={64} loading="lazy" class="aspect-[3/4] h-full w-full rounded-[18px] object-cover" />
      </div>
    </div>
  </section>

  <!-- Winkel: foto, openingstijden met vandaag, adres en route. -->
  <section id="winkel" class="wrap py-12 sm:py-20 lg:py-28" aria-labelledby="winkel-kop">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker text-stil">{T.winkelKicker}</p>
        <h2 id="winkel-kop" class="mt-3 text-4xl">{T.winkelKop}</h2>
      </div>
      <p class="text-lg lg:col-span-4 lg:col-start-9">{T.ligging}</p>
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-12">
      <div class="relative overflow-hidden rounded-[24px] shadow-zacht lg:col-span-7">
        <Picture src={pui} alt={T.puiAlt} formats={['avif']} fallbackFormat="webp" widths={[560, 900, 1200]}
          sizes="(min-width: 1024px) 700px, 100vw" quality={68} class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto" />
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-[linear-gradient(180deg,transparent,#1f1812cc)] p-5 sm:p-6">
          <p class="font-kop text-lg font-bold text-wit [font-stretch:105%]">{T.puiOnder}</p>
        </div>
      </div>
      <div class="lg:col-span-5">
        <Tijden taal={taal} />
        <div class="mt-6 px-1">
          <p class="font-semibold text-inkt">Kast van Klaas</p>
          <p class="text-stil">{zaak.straat}, {zaak.postcode} {zaak.plaats}</p>
          <p class="mt-2"><a class="link" href={zaak.telefoonLink} data-goatcounter-click="bel-winkel">{T.nr}</a> {T.of} <a class="link" href={`mailto:${zaak.email}`}>{zaak.email}</a></p>
          <a href="https://www.google.com/maps/dir/?api=1&destination=Kaasmarkt+3%2C+2312+HZ+Leiden" rel="noopener" class="knop mt-5" data-goatcounter-click="route-home">{T.route}</a>
          <p class="mt-6 text-sm text-stil">{T.joosje[0]}<a class="link font-medium" href={lp(taal, '/joosjedoodles/')}>{T.joosje[1]}</a>{T.joosje[2]}</p>
        </div>
      </div>
    </div>
  </section>

  <Reviews taal={taal} />
  <Aanvraag bron="home" taal={taal} />
  <CtaBand taal={taal} />

  <script define:vars={{ tijdenJson, openJson }}>
    const T = JSON.parse(tijdenJson);
    const O = JSON.parse(openJson);
    const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
    const d = nu.getDay(); const u = nu.getHours() + nu.getMinutes() / 60;
    const v = T.find((t) => t.nr === d);
    const fmt = (x) => `${String(Math.floor(x)).padStart(2, '0')}${O.sep}${x % 1 ? '30' : '00'}`;
    let tekst;
    if (u < v.van) tekst = `${O.vandaag}${fmt(v.van)}${O.tot}${fmt(v.tot)}${O.uur}`;
    else if (u < v.tot) tekst = `${O.nu}${fmt(v.tot)}${O.uur}`;
    else { const m = T.find((t) => t.nr === (d + 1) % 7); tekst = `${O.morgen}${fmt(m.van)}${O.uur}`; }
    document.querySelectorAll('[data-open]').forEach((e) => (e.textContent = tekst));
  </script>
  <script>
    // Stipjes onder de veegrij volgen de stap die links in beeld staat.
    const rij = document.querySelector<HTMLElement>('[data-stappen]');
    const stippen = [...document.querySelectorAll<HTMLElement>('[data-stip]')];
    if (rij && stippen.length) {
      const items = [...rij.querySelectorAll<HTMLElement>('li')];
      let wacht = false;
      const zet = () => {
        wacht = false;
        const links = rij.getBoundingClientRect().left;
        let best = 0, afstand = Infinity;
        items.forEach((li, i) => { const d = Math.abs(li.getBoundingClientRect().left - links - parseFloat(getComputedStyle(rij).paddingLeft)); if (d < afstand) { afstand = d; best = i; } });
        if (rij.scrollLeft + rij.clientWidth >= rij.scrollWidth - 4) best = items.length - 1;
        stippen.forEach((s, i) => { s.classList.toggle('bg-inkt', i === best); s.classList.toggle('bg-lijn', i !== best); });
      };
      rij.addEventListener('scroll', () => { if (!wacht) { wacht = true; requestAnimationFrame(zet); } }, { passive: true });
    }
  </script>
</Basis>
