---
import { Picture, getImage } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import KastKaart from '../components/KastKaart.astro';
import Icoon from '../components/Icoon.astro';
import Tijden from '../components/Tijden.astro';
import Reviews from '../components/Reviews.astro';
import Aanvraag from '../components/Aanvraag.astro';
import CtaBand from '../components/CtaBand.astro';
import { alleKasten, winkelSchema } from '../lib/kasten';
import { zaak, tijden, SITE } from '../lib/site';
import { type Taal, lp, TALEN, TAAL_INFO } from '../lib/i18n';
import hero from '../assets/site/hero.jpg';
import klaasIndia from '../assets/site/klaas-india.jpg';
import pui from '../assets/site/pui.jpg';
import winkelKasten from '../assets/site/winkel-kasten.jpg';
import tafel from '../assets/site/tafel.jpg';
import indiaWerkplaats from '../assets/site/india-werkplaats.jpg';
import indiaDeuren from '../assets/site/india-deuren.jpg';
import indiaBlikjes from '../assets/site/india-blikjes.jpg';
import dahlias from '../assets/site/dahlias.jpg';
import styling from '../assets/site/styling.jpg';

interface Props { taal: Taal }
const { taal } = Astro.props;
const T = {
  nl: {
    titel: 'Kast van Klaas | Oude India kasten van teakhout in Leiden',
    beschrijving: 'Oude India kasten van teakhout, persoonlijk uitgezocht door Klaas Hoekstra en rechtstreeks geïmporteerd. Elke kast is uniek. Winkel op de Kaasmarkt 3 in Leiden.',
    heroAlt: 'Blauwe en groene vitrinekast achter een teakhouten tafel, in de winkel van Kast van Klaas',
    h1: ['Oude, unieke kasten uit ', 'India.'],
    heroTekst: 'De mooiste exemplaren van primair teakhout, zestig tot meer dan honderd jaar oud. Te zien, voelen en ruiken in de winkel bij Kast van Klaas, Kaasmarkt 3 in Leiden.',
    bekijk: 'Bekijk de kasten', belKlaas: 'Bel Klaas', opGoogle: 'op Google', reviews: 'reviews', winkel: 'Winkel', elkeDag: 'elke dag open',
    open: { vandaag: 'vandaag open, ', nu: 'nu open, tot ', morgen: 'morgen open vanaf ', tot: ' tot ', sep: '.', uur: '' },
    soorten: 'Verschillende soorten kasten',
    kaarten: [
      { titel: 'India kasten', tekst: 'Klaas zoekt, selecteert, transporteert en bezorgt.', alt: 'Oude Indiase kasten in de winkel van Kast van Klaas' },
      { titel: 'Meer bij Kast van Klaas', tekst: 'Tafels, accessoires en meer uit India.', alt: 'Blauwe Indiase tafel met servies en bloemen' },
    ],
    mo: { tekst: 'Styling- en interieuradvies bij KASTVANKLAAS door GETINSPIREDBYMO', alt: 'Twee houten stoelen en een gedekte tafel op een binnenplaats onder een boom' },
    deKasten: 'De kasten van Klaas',
    stappen: [
      { t: 'Bekijken', z: 'De collectie online of in het echt in de winkel bekijken? Dat kan, op de Kaasmarkt 3 in Leiden.' },
      { t: 'Reserveren', z: 'Interesse in een kast? Klik op "Reserveer deze kast". Of bel, app of mail Klaas.' },
      { t: 'Klaas neemt contact op', z: '' },
      { t: 'Bezorgen', z: 'Tegen een vergoeding worden de kasten thuis bezorgd.' },
    ],
    werkwijze: 'Van kastnummer tot kast in huis.',
    werkwijzeTekst: 'Heb je interesse in een kast? Dan kan je deze reserveren. Vervolgens neemt Klaas contact met je op om samen de rest te bespreken.',
    veeg: 'Veeg voor de volgende stap',
    collectieKop: 'Onze mooie collectie Indiase kasten is te bewonderen op de Kaasmarkt 3 in Leiden.',
    parkeren: 'Parkeren kan voor de deur van de winkel.',
    vraag: 'Stel een vraag', bel: 'Bel', nr: zaak.telefoon,
    dahliasAlt: 'Kasten, een lange tafel en bloemen in de winkel van Kast van Klaas',
    klaasAlt: 'Klaas Hoekstra voor een verweerde roze muur',
    overKicker: 'Over Klaas', overKop: ['Klaas zoekt elke kast ', 'zelf', ' uit.'],
    over: [
      'Klaas kent Noord-India als geen ander. Het is al meer dan twintig jaar zijn geliefde bestemming, waar hij enkele keren per jaar naartoe reist om persoonlijk op zoek te gaan naar de mooiste Indiase kasten.',
      'De kasten zijn veelal minimaal zestig tot meer dan honderd jaar oud en zijn nog gemaakt van zogenoemd primair teakhout, dat tegenwoordig steeds zeldzamer is.',
      'Waar nodig worden ze onder toezicht van Klaas bij lokale Indiase meubelmakers gerestaureerd, voordat ze naar Nederland worden verscheept.',
    ],
    meerOver: 'Meer over Klaas',
    stripAlt: ['Indiase meubelmakers in een werkplaats, voor gerestaureerde vitrinekasten', 'Oude Indiase deuren en kasten, opgesteld in de winkel', 'Oude Indiase blikjes met handgeschilderde opdruk'],
    winkelKicker: 'Winkel en openingstijden', winkelKop: 'Kom kijken op de Kaasmarkt.',
    ligging: `Achter de Hooigracht, hoogte Oude Rijn. ${zaak.parkeren}`,
    puiAlt: 'De ingang van de winkel van Kast van Klaas, met groene tuinstoelen voor de deur', puiOnder: 'De winkel aan de Kaasmarkt',
    of: 'of', route: 'Plan route', joosje: ['Ook in de winkel: werk van ', 'Joosje Doodles', '.'],
  },
  de: {
    titel: 'Kast van Klaas | Alte indische Teakholzschränke in Leiden',
    beschrijving: 'Alte indische Schränke aus Teakholz, von Klaas Hoekstra persönlich ausgesucht und direkt importiert. Jeder ein Unikat. Laden am Kaasmarkt 3 in Leiden.',
    heroAlt: 'Blauer und grüner Vitrinenschrank hinter einem Teakholztisch im Laden von Kast van Klaas',
    h1: ['Alte, einzigartige Schränke aus ', 'Indien.'],
    heroTekst: 'Die schönsten Exemplare aus Teakholz aus Primärwald, sechzig bis über hundert Jahre alt. Zum Ansehen, Anfassen und Riechen im Laden von Kast van Klaas, Kaasmarkt 3 in Leiden.',
    bekijk: 'Schränke ansehen', belKlaas: 'Klaas anrufen', opGoogle: 'auf Google', reviews: 'Bewertungen', winkel: 'Laden', elkeDag: 'jeden Tag geöffnet',
    open: { vandaag: 'heute geöffnet, ', nu: 'jetzt geöffnet, bis ', morgen: 'morgen geöffnet ab ', tot: ' bis ', sep: ':', uur: ' Uhr' },
    soorten: 'Verschiedene Arten von Schränken',
    kaarten: [
      { titel: 'Schränke aus Indien', tekst: 'Klaas sucht, wählt aus, transportiert und liefert.', alt: 'Alte indische Schränke im Laden von Kast van Klaas' },
      { titel: 'Mehr bei Kast van Klaas', tekst: 'Tische, Accessoires und mehr aus Indien.', alt: 'Blauer indischer Tisch mit Geschirr und Blumen' },
    ],
    mo: { tekst: 'Styling- und Einrichtungsberatung bei KASTVANKLAAS von GETINSPIREDBYMO', alt: 'Zwei Holzstühle und ein gedeckter Tisch in einem Innenhof unter einem Baum' },
    deKasten: 'Die Schränke von Klaas',
    stappen: [
      { t: 'Ansehen', z: 'Die Kollektion online oder in echt im Laden ansehen? Das geht, am Kaasmarkt 3 in Leiden.' },
      { t: 'Reservieren', z: 'Interesse an einem Schrank? Klicken Sie auf „Diesen Schrank reservieren“. Oder rufen Sie Klaas an, schreiben Sie ihm per WhatsApp oder E-Mail.' },
      { t: 'Klaas meldet sich', z: '' },
      { t: 'Lieferung', z: 'Gegen eine Gebühr werden die Schränke nach Hause geliefert.' },
    ],
    werkwijze: 'Von der Schranknummer bis zum Schrank bei Ihnen zu Hause.',
    werkwijzeTekst: 'Interessieren Sie sich für einen Schrank? Dann können Sie ihn reservieren. Danach meldet sich Klaas bei Ihnen, um gemeinsam alles Weitere zu besprechen.',
    veeg: 'Wischen für den nächsten Schritt',
    collectieKop: 'Unsere schöne Kollektion indischer Schränke können Sie am Kaasmarkt 3 in Leiden bewundern.',
    parkeren: 'Parken können Sie direkt vor der Ladentür.',
    vraag: 'Frage stellen', bel: '', nr: '+31 6 26 37 84 80',
    dahliasAlt: 'Schränke, ein langer Tisch und Blumen im Laden von Kast van Klaas',
    klaasAlt: 'Klaas Hoekstra vor einer verwitterten rosa Wand',
    overKicker: 'Über Klaas', overKop: ['Klaas sucht jeden Schrank ', 'selbst', ' aus.'],
    over: [
      'Klaas kennt Nordindien wie kein Zweiter. Seit mehr als zwanzig Jahren ist es sein Lieblingsziel, wohin er mehrmals im Jahr reist, um persönlich nach den schönsten indischen Schränken zu suchen.',
      'Die Schränke sind meist mindestens sechzig bis über hundert Jahre alt und noch aus sogenanntem Teakholz aus Primärwald gefertigt, das heute immer seltener wird.',
      'Wo nötig, werden sie unter Aufsicht von Klaas bei örtlichen indischen Möbeltischlern restauriert, bevor sie in die Niederlande verschifft werden.',
    ],
    meerOver: 'Mehr über Klaas',
    stripAlt: ['Indische Möbeltischler in einer Werkstatt vor restaurierten Vitrinenschränken', 'Alte indische Türen und Schränke, im Laden aufgestellt', 'Alte indische Dosen mit handbemaltem Aufdruck'],
    winkelKicker: 'Laden und Öffnungszeiten', winkelKop: 'Besuchen Sie uns am Kaasmarkt.',
    ligging: 'Hinter der Hooigracht, auf Höhe des Oude Rijn. Bequem parken auf dem Kaasmarkt, direkt vor der Ladentür.',
    puiAlt: 'Der Eingang des Ladens von Kast van Klaas mit grünen Gartenstühlen vor der Tür', puiOnder: 'Der Laden am Kaasmarkt',
    of: 'oder', route: 'Route planen', joosje: ['Auch im Laden: Werke von ', 'Joosje Doodles', '.'],
  },
  en: {
    titel: 'Kast van Klaas | Old Indian teak cabinets in Leiden',
    beschrijving: 'Old Indian teak cabinets, hand-picked by Klaas Hoekstra and imported directly. Every cabinet is one of a kind. Shop at Kaasmarkt 3 in Leiden.',
    heroAlt: 'Blue and green display cabinets behind a teak table in the Kast van Klaas shop',
    h1: ['Old, one-of-a-kind cabinets from ', 'India.'],
    heroTekst: 'The finest pieces in old-growth teak, sixty to more than a hundred years old. Come and see, touch and smell them in the Kast van Klaas shop, Kaasmarkt 3 in Leiden.',
    bekijk: 'View the cabinets', belKlaas: 'Call Klaas', opGoogle: 'on Google', reviews: 'reviews', winkel: 'Shop', elkeDag: 'open every day',
    open: { vandaag: 'open today, ', nu: 'open now, until ', morgen: 'open tomorrow from ', tot: ' to ', sep: ':', uur: '' },
    soorten: 'Different kinds of cabinets',
    kaarten: [
      { titel: 'Indian cabinets', tekst: 'Klaas searches, selects, ships and delivers.', alt: 'Old Indian cabinets in the Kast van Klaas shop' },
      { titel: 'More at Kast van Klaas', tekst: 'Tables, accessories and more from India.', alt: 'Blue Indian table with china and flowers' },
    ],
    mo: { tekst: 'Styling and interior advice at KASTVANKLAAS by GETINSPIREDBYMO', alt: 'Two wooden chairs and a laid table in a courtyard under a tree' },
    deKasten: 'The cabinets of Klaas',
    stappen: [
      { t: 'Have a look', z: 'Browse the collection online or see it for real in the shop? You can, at Kaasmarkt 3 in Leiden.' },
      { t: 'Reserve', z: 'Interested in a cabinet? Click "Reserve this cabinet". Or call, WhatsApp or email Klaas.' },
      { t: 'Klaas gets in touch', z: '' },
      { t: 'Delivery', z: 'For a fee, the cabinets are delivered to your home.' },
    ],
    werkwijze: 'From cabinet number to cabinet in your home.',
    werkwijzeTekst: 'Interested in a cabinet? Then you can reserve it. Klaas will then get in touch with you to discuss the rest together.',
    veeg: 'Swipe for the next step',
    collectieKop: 'Our beautiful collection of Indian cabinets can be admired at Kaasmarkt 3 in Leiden.',
    parkeren: 'You can park right in front of the shop.',
    vraag: 'Ask a question', bel: '', nr: '+31 6 26 37 84 80',
    dahliasAlt: 'Cabinets, a long table and flowers in the Kast van Klaas shop',
    klaasAlt: 'Klaas Hoekstra in front of a weathered pink wall',
    overKicker: 'About Klaas', overKop: ['Klaas picks every cabinet ', 'himself', '.'],
    over: [
      'Klaas knows North India like no one else. For more than twenty years it has been his favourite destination, and he travels there several times a year to personally search for the most beautiful Indian cabinets.',
      'Most of the cabinets are at least sixty to more than a hundred years old and are still made of what is known as old-growth teak, which is becoming increasingly rare.',
      'Where needed, they are restored by local Indian furniture makers under Klaas’s supervision before being shipped to the Netherlands.',
    ],
    meerOver: 'More about Klaas',
    stripAlt: ['Indian furniture makers in a workshop, in front of restored display cabinets', 'Old Indian doors and cabinets, set out in the shop', 'Old Indian tins with hand-painted designs'],
    winkelKicker: 'Shop and opening hours', winkelKop: 'Come and visit us on the Kaasmarkt.',
    ligging: 'Behind the Hooigracht, level with the Oude Rijn. Easy parking on the Kaasmarkt, right outside the shop door.',
    puiAlt: 'The entrance to the Kast van Klaas shop, with green garden chairs outside the door', puiOnder: 'The shop on the Kaasmarkt',
    of: 'or', route: 'Plan your route', joosje: ['Also in the shop: work by ', 'Joosje Doodles', '.'],
  },
}[taal];

const kasten = (await alleKasten(taal)).filter((k) => k.inCollectie);
const teKoop = kasten.filter((k) => k.status === 'te-koop');
const uitgelicht = teKoop.filter((k) => k.categorie === 'india-kasten').slice(0, 8);
// Hero-foto vooraf laden (zelfde avif-varianten als de Picture), zodat de grootste afbeelding eerder in beeld is.
const heroBreedtes = [480, 720, 960, 1170];
const heroSet = (await Promise.all(heroBreedtes.map(async (w) => `${(await getImage({ src: hero, width: w, format: 'avif', quality: 42 })).src} ${w}w`))).join(', ');
const winkelBeeld = new URL((await getImage({ src: hero, width: 1170, format: 'jpg' })).src, SITE).href;
const uur = (t: string) => +t.slice(0, 2) + +t.slice(3) / 60;
const tijdenJson = JSON.stringify(tijden.map((t, i) => ({ nr: (i + 1) % 7, van: uur(t.open), tot: uur(t.dicht) })));
const openJson = JSON.stringify(T.open);
const stappen = ['oog', 'bladwijzer', 'tel', 'huis'].map((icoon, i) => ({ icoon, ...T.stappen[i] }));
const score = taal === 'en' ? zaak.google.score.replace(',', '.') : zaak.google.score;
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Kast van Klaas', alternateName: 'Kastvanklaas', url: `${SITE}/`, inLanguage: TALEN.map((t) => TAAL_INFO[t].schema), publisher: { '@id': `${SITE}/#winkel` } };
---
<Basis titel={T.titel} beschrijving={T.beschrijving} pad="/" taal={taal} thuis schema={[winkelSchema(winkelBeeld, kasten, taal), website]}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroSet} imagesizes="(min-width: 1024px) 58vw, 100vw" fetchpriority="high" />
  <!-- Hero: links donker vlak met de kop, rechts de winkel die naar links in het donker overloopt. -->
  <section class="donker relative isolate overflow-hidden bg-nacht text-wit lg:min-h-[calc(100svh-2.5rem)]">
    <div class="absolute inset-x-0 top-0 -z-10 h-[58svh] [mask-image:linear-gradient(180deg,#000_45%,transparent)] lg:inset-y-0 lg:left-auto lg:right-0 lg:h-full lg:w-[58%] lg:[mask-image:linear-gradient(90deg,transparent_4%,#000_48%)]">
      <Picture src={hero} alt={T.heroAlt} formats={['avif']} fallbackFormat="webp"
        widths={heroBreedtes} sizes="(min-width: 1024px) 58vw, 100vw" quality={42} loading="eager" fetchpriority="high"
        class="h-full w-full object-cover object-[60%_45%]" />
    </div>
    <div class="wrap pb-14 pt-[50svh] lg:flex lg:min-h-[calc(100svh-2.5rem)] lg:items-center lg:pb-20 lg:pt-36">
      <div class="lg:max-w-[48rem]">
        <p class="kicker text-saffraan">Kaasmarkt 3 Leiden</p>
        <h1 class="mt-5 text-hero text-wit [text-shadow:0_2px_28px_#1f1812]">{T.h1[0]}<span class="sier text-saffraan">{T.h1[1]}</span></h1>
        <p class="mt-6 max-w-[34rem] text-lg text-wit/90 md:text-xl">{T.heroTekst}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={lp(taal, '/webshop/cat/india-kasten/')} class="knop knop-geel">{T.bekijk}<Icoon naam="pijl" /></a>
          <a href={zaak.telefoonLink} class="knop knop-glas" data-goatcounter-click="bel-hero"><Icoon naam="tel" />{T.belKlaas}</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-wit/85">
          <p class="flex items-center gap-2"><span class="flex text-saffraan" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="text-wit">{score}</b> {T.opGoogle}, {zaak.google.aantal} {T.reviews}</p>
          <p>{T.winkel} <b class="text-wit" data-open>{T.elkeDag}</b></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Collectie in twee grote fotokaarten, met snelle links per soort. -->
  <section class="wrap py-12 sm:py-20 lg:py-28" aria-labelledby="collectie-kop">
    <h2 id="collectie-kop" class="text-4xl">{T.soorten}</h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {[
        { ...T.kaarten[0], href: lp(taal, '/webshop/cat/india-kasten/'), beeld: winkelKasten },
        { ...T.kaarten[1], href: lp(taal, '/meer-bij-kastvanklaas/'), beeld: tafel },
      ].map((c) => (
        <div>
          <a href={c.href} class="group relative block overflow-hidden rounded-[24px] no-underline shadow-zacht">
            <Picture src={c.beeld} alt={c.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 720, 900]} sizes="(min-width: 1024px) 600px, 100vw" quality={50}
              class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,#1f181200_25%,#1f1812b3_60%,#1f1812f2_100%)]"></div>
            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 sm:p-8">
              <div>
                <h3 class="text-3xl font-extrabold text-wit [font-stretch:112%]">{c.titel}</h3>
                <p class="mt-2 max-w-sm text-wit/85">{c.tekst}</p>
              </div>
              <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-wit text-inkt transition-transform group-hover:translate-x-1" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
            </div>
          </a>
        </div>
      ))}
    </div>
    <!-- Op verzoek van Klaas: styling- en interieuradvies door GetInspiredByMo, met link naar haar site. -->
    <a href="https://www.getinspiredbymo.com" target="_blank" rel="noopener" class="group mt-6 grid gap-4 no-underline lg:grid-cols-2 lg:gap-6" data-goatcounter-click="getinspiredbymo">
      <div class="overflow-hidden rounded-[24px] shadow-zacht lg:col-start-2 lg:row-start-1">
        <Picture src={styling} alt={T.mo.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 720, 900]} sizes="(min-width: 1024px) 600px, 100vw" quality={50}
          class="aspect-[4/3] w-full object-cover object-[50%_62%] transition-transform duration-700 group-hover:scale-[1.03] lg:aspect-[16/9]" />
      </div>
      <p class="flex items-center gap-3 text-lg font-semibold text-inkt lg:col-start-1 lg:row-start-1 lg:items-end lg:justify-end lg:pb-2 lg:text-right lg:text-2xl">
        <span class="underline decoration-1 underline-offset-4">{T.mo.tekst}</span>
        <Icoon naam="pijl" class="h-5 w-5 flex-none transition-transform group-hover:translate-x-1" />
      </p>
    </a>
  </section>

  <!-- Nu te koop: de kasten zelf, met nummer en prijs. -->
  <section class="wrap pb-12 sm:pb-20 lg:pb-28" aria-labelledby="nu-te-koop">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="nu-te-koop" class="text-4xl">{T.deKasten}</h2>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-4">
      {uitgelicht.map((k) => <KastKaart kast={k} />)}
    </ul>
  </section>

  <!-- Zo werkt het: van bekijken tot bij je thuis. Alleen wat de site echt biedt. -->
  <section class="bg-ijs py-12 sm:py-20 lg:py-28" aria-labelledby="werkwijze-kop">
    <div class="wrap">
      <h2 id="werkwijze-kop" class="text-4xl">{T.werkwijze}</h2>
      <p class="mt-5 max-w-3xl text-lg">{T.werkwijzeTekst}</p>
      <!-- Stappen van links naar rechts, op mobiel als veegrij. -->
      <ol data-stappen class="relative -mx-5 mt-10 flex snap-x snap-mandatory scroll-pl-5 gap-6 overflow-x-auto px-5 pb-4 pt-2 md:scroll-pl-8 [scrollbar-width:none] md:-mx-8 md:px-8 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-8 lg:overflow-visible lg:px-0 lg:pb-0 lg:pt-0 after:w-[calc(22%-1.5rem)] after:flex-none after:content-[''] sm:after:w-[calc(58%-1.5rem)] lg:after:hidden">
        <span class="absolute left-7 right-[12%] top-7 hidden h-px bg-lijn lg:block" aria-hidden="true"></span>
        {stappen.map((s, i) => (
          <li class="relative w-[78%] flex-none snap-start rounded-[18px] bg-wit p-5 shadow-zacht ring-1 ring-lijn sm:w-[42%] lg:w-auto lg:rounded-none lg:bg-transparent lg:p-0 lg:shadow-none lg:ring-0">
            <span class="relative grid h-14 w-14 place-items-center rounded-full bg-wit text-inkt shadow-zacht ring-1 ring-lijn">
              <Icoon naam={s.icoon} class="h-6 w-6" />
              <span class="absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-nacht text-xs font-bold text-wit">{i + 1}</span>
            </span>
            <h3 class="mt-5 text-lg">{s.t}</h3>
            {s.z && <p class="mt-2 text-[.95rem]">{s.z}</p>}
          </li>
        ))}
      </ol>
      <!-- Alleen op mobiel/tablet: laten zien dat de rij doorloopt. -->
      <div class="mt-3 flex items-center justify-between gap-4 lg:hidden">
        <span class="flex gap-2" aria-hidden="true">
          {stappen.map((_, i) => <span data-stip class:list={['h-2 w-2 rounded-full transition-colors', i === 0 ? 'bg-inkt' : 'bg-lijn']}></span>)}
        </span>
        <span class="whitespace-nowrap text-sm text-stil max-[359px]:text-xs" aria-hidden="true">{T.veeg} &rarr;</span>
      </div>
      <div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h3 class="text-[1.45rem] font-extrabold leading-tight [font-stretch:108%] sm:text-[1.75rem]">{T.collectieKop}</h3>
          <p class="mt-4 text-lg">{T.parkeren}</p>
