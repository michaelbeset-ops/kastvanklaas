            <a href="#vraag" class="knop">{T.vraag}</a>
            <a href={zaak.telefoonLink} class="knop knop-wit" data-goatcounter-click="bel-werkwijze"><Icoon naam="tel" />{[T.bel, T.nr].filter(Boolean).join(' ')}</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <Picture src={dahlias} alt={T.dahliasAlt} formats={['avif']} fallbackFormat="webp" widths={[560, 900, 1170]}
            sizes="(min-width: 1024px) 560px, 100vw" quality={68} class="aspect-[16/10] w-full rounded-[24px] object-cover shadow-zacht" />
