---
import { Picture } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import PaginaKop from '../components/PaginaKop.astro';
import { kruimelSchema } from '../lib/kasten';
import { zaak, waLink } from '../lib/site';
import { type Taal, UI, lp } from '../lib/i18n';
import styling from '../assets/site/styling.jpg';
// De oude pagina had alleen de kop "STYLING advies" en deze foto. Geen tekst verzonnen; alleen de weg naar Klaas.
interface Props { taal: Taal }
const { taal } = Astro.props;
const T = {
  nl: { titel: 'Styling advies | Kast van Klaas Leiden', beschrijving: 'Styling advies bij Kast van Klaas: oude meubels uit India in jouw interieur. Kom langs op de Kaasmarkt in Leiden of vraag het Klaas.',
    h1: 'Styling advies', alt: 'Twee houten stoelen en een gedekte tafel op een binnenplaats onder een boom',
    tekst: 'Wil je weten hoe een kast of tafel uit India staat in jouw huis? Kom langs in de winkel op de Kaasmarkt, of stuur Klaas een bericht.', knop: 'Vraag Klaas', wa: 'Hallo Klaas, ik wil graag styling advies.', nr: zaak.telefoon },
  de: { titel: 'Styling-Beratung | Kast van Klaas Leiden', beschrijving: 'Styling-Beratung bei Kast van Klaas: alte Möbel aus Indien in Ihrem Interieur. Besuchen Sie uns am Kaasmarkt in Leiden oder fragen Sie Klaas.',
    h1: 'Styling-Beratung', alt: 'Zwei Holzstühle und ein gedeckter Tisch in einem Innenhof unter einem Baum',
    tekst: 'Möchten Sie wissen, wie ein Schrank oder Tisch aus Indien bei Ihnen zu Hause wirkt? Besuchen Sie den Laden am Kaasmarkt oder schicken Sie Klaas eine Nachricht.', knop: 'Klaas fragen', wa: 'Hallo Klaas, ich hätte gern eine Styling-Beratung.', nr: '+31 6 26 37 84 80' },
  en: { titel: 'Styling advice | Kast van Klaas Leiden', beschrijving: 'Styling advice at Kast van Klaas: old furniture from India in your interior. Visit us on the Kaasmarkt in Leiden or ask Klaas.',
    h1: 'Styling advice', alt: 'Two wooden chairs and a laid table in a courtyard under a tree',
    tekst: 'Would you like to know how a cabinet or table from India would look in your home? Visit the shop on the Kaasmarkt, or send Klaas a message.', knop: 'Ask Klaas', wa: 'Hello Klaas, I would like some styling advice.', nr: '+31 6 26 37 84 80' },
}[taal];
---
<Basis titel={T.titel} beschrijving={T.beschrijving} pad="/webshop/styling-advies/" taal={taal}
  schema={[kruimelSchema([{ naam: UI[taal].home, pad: lp(taal, '/') }, { naam: T.h1, pad: lp(taal, '/webshop/styling-advies/') }])]}>
  <PaginaKop kruimel={T.h1} titel={T.h1} taal={taal} />
  <section class="wrap mt-14 grid gap-10 md:grid-cols-12 md:gap-14">
    <figure class="md:col-span-6">
      <Picture src={styling} alt={T.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 48vw, 100vw" quality={72} loading="eager" class="h-auto w-full rounded-[24px]" />
    </figure>
    <div class="md:col-span-5 md:col-start-8 md:self-end">
      <p class="text-lg leading-relaxed">{T.tekst}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a class="knop" href={waLink(T.wa)} data-goatcounter-click="whatsapp-styling">{T.knop}</a>
        <a class="link" href={zaak.telefoonLink} data-goatcounter-click="bel-styling">{T.nr}</a>
      </div>
    </div>
  </section>
</Basis>
