---
import { Picture, getImage } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import KastKaart from '../components/KastKaart.astro';
import Reserveer from '../components/Reserveer.astro';
import { alleKasten, padVan, label, prijsTekst, seoTitel, seoBeschrijving, productSchema, kruimelSchema, isTeak, type Kast } from '../lib/kasten';
import { SITE, zaak, tijden, waLink } from '../lib/site';
import { type Taal, TALEN, UI, CATEGORIE_T, lp, matenT, tijdT } from '../lib/i18n';
import Icoon from '../components/Icoon.astro';
import klaasFoto from '../assets/site/klaas.jpg';

interface Props { taal: Taal; slug: string }
const { taal, slug } = Astro.props;
const kasten = await alleKasten(taal);
const kast = kasten.find((k) => k.slug === slug)!;
// In welke talen bestaat deze kast als echte (vertaalde, indexeerbare) pagina? Alleen daarheen gaan de hreflang-links.
const talen: Taal[] = [];
for (const t of TALEN) if ((await alleKasten(t)).find((k) => k.slug === slug)?.toon.vertaald) talen.push(t);
const vertaald = kast.toon.vertaald;

const u = UI[taal];
const T = {
  nl: { uniek: 'Uniek exemplaar: er is er maar één van.', verkochtRest: 'Klaas zoekt zijn kasten zelf uit in India. Vraag hem wat er binnenkomt.', zoek: "Zoek je zo'n kast? Vraag Klaas",
    nuTeKoop: 'Bekijk wat nu te koop is', wa: 'Vraag via WhatsApp',
    punten: ['Klaas neemt contact met je op over deze kast.', 'Kom hem bekijken op de Kaasmarkt, ook op afspraak.', 'Tegen een vergoeding worden de kasten thuis bezorgd.'],
    spec: { nr: 'Kastnummer', maten: 'Maten', soort: 'Soort', hout: 'Hout', herkomst: 'Herkomst', teak: 'Teakhout', india: 'India' },
    vraagKlaas: 'Vraag het Klaas', opGoogle: 'op Google', komKijken: 'Kom kijken op de Kaasmarkt', parkeren: zaak.parkeren,
    tijden: (t: typeof tijden) => `Ma tot vr ${tijdT(t[0].open, 'nl')} tot ${tijdT(t[0].dicht, 'nl')}, za ${tijdT(t[5].open, 'nl')} tot ${tijdT(t[5].dicht, 'nl')}, zo ${tijdT(t[6].open, 'nl')} tot ${tijdT(t[6].dicht, 'nl')}. Of op afspraak.`,
    kleur: 'Liever een andere kleur? Dat kan in overleg, vraag Klaas naar de mogelijkheden.', zelfdeLijn: 'Nu te koop, in dezelfde lijn', ookKijken: 'Bekijk ook',
    waVerkocht: (w: string) => `Hoi Klaas, ik zag ${w} op de site. Die is verkocht, heb je iets vergelijkbaars?`, waVraag: (w: string) => `Hoi Klaas, ik heb een vraag over ${w}.`,
    wie: (k: Kast) => (k.code ? `kast ${k.code}` : `"${k.naam}"`), klaasAlt: 'Klaas Hoekstra' },
  de: { uniek: 'Einzelstück: Es gibt ihn nur einmal.', verkochtRest: 'Klaas sucht seine Schränke selbst in Indien aus. Fragen Sie ihn, was neu hereinkommt.', zoek: 'Suchen Sie so einen Schrank? Fragen Sie Klaas',
    nuTeKoop: 'Ansehen, was jetzt zu verkaufen ist', wa: 'Frage per WhatsApp',
    punten: ['Klaas meldet sich bei Ihnen zu diesem Schrank.', 'Sehen Sie ihn sich am Kaasmarkt an, auch nach Vereinbarung.', 'Gegen eine Gebühr werden die Schränke nach Hause geliefert.'],
    spec: { nr: 'Schranknummer', maten: 'Maße', soort: 'Kategorie', hout: 'Holz', herkomst: 'Herkunft', teak: 'Teakholz', india: 'Indien' },
    vraagKlaas: 'Fragen Sie Klaas', opGoogle: 'auf Google', komKijken: 'Besuchen Sie uns am Kaasmarkt', parkeren: 'Bequem parken auf dem Kaasmarkt, direkt vor der Ladentür.',
    tijden: (t: typeof tijden) => `Mo bis Fr ${t[0].open} bis ${t[0].dicht} Uhr, Sa ${t[5].open} bis ${t[5].dicht} Uhr, So ${t[6].open} bis ${t[6].dicht} Uhr. Oder nach Vereinbarung.`,
    kleur: 'Lieber eine andere Farbe? Das ist nach Absprache möglich, fragen Sie Klaas nach den Möglichkeiten.', zelfdeLijn: 'Jetzt zu verkaufen, in derselben Art', ookKijken: 'Ebenfalls ansehen',
    waVerkocht: (w: string) => `Hallo Klaas, ich habe ${w} auf der Website gesehen. Es ist verkauft, haben Sie etwas Ähnliches?`, waVraag: (w: string) => `Hallo Klaas, ich habe eine Frage zu ${w}.`,
    wie: (k: Kast) => (k.code ? `Nr. ${k.code}` : `„${k.toon.naam}“`), klaasAlt: 'Klaas Hoekstra' },
  en: { uniek: 'One of a kind: there is only one.', verkochtRest: 'Klaas picks his cabinets himself in India. Ask him what is coming in.', zoek: 'Looking for a cabinet like this? Ask Klaas',
    nuTeKoop: 'See what is for sale now', wa: 'Ask via WhatsApp',
    punten: ['Klaas will get in touch with you about this cabinet.', 'Come and see it on the Kaasmarkt, also by appointment.', 'For a fee, the cabinets are delivered to your home.'],
    spec: { nr: 'Cabinet number', maten: 'Dimensions', soort: 'Category', hout: 'Wood', herkomst: 'Origin', teak: 'Teak', india: 'India' },
    vraagKlaas: 'Ask Klaas', opGoogle: 'on Google', komKijken: 'Come and visit us on the Kaasmarkt', parkeren: 'Easy parking on the Kaasmarkt, right outside the shop door.',
    tijden: (t: typeof tijden) => `Mon to Fri ${t[0].open} to ${t[0].dicht}, Sat ${t[5].open} to ${t[5].dicht}, Sun ${t[6].open} to ${t[6].dicht}. Or by appointment.`,
    kleur: 'Prefer a different colour? That is possible in consultation, ask Klaas about the options.', zelfdeLijn: 'For sale now, in the same style', ookKijken: 'See also',
    waVerkocht: (w: string) => `Hello Klaas, I saw ${w} on the website. It has been sold, do you have anything similar?`, waVraag: (w: string) => `Hello Klaas, I have a question about ${w}.`,
    wie: (k: Kast) => (k.code ? `no. ${k.code}` : `"${k.toon.naam}"`), klaasAlt: 'Klaas Hoekstra' },
}[taal];

const verkocht = kast.status === 'verkocht';
// Sfeerfoto's en nieuws (ook de naamloze in 'Meer uit India') zijn geen product: geen prijs, knop of Product-schema.
const inspiratie = !kast.naam || kast.categorie === 'inspiratie' || kast.categorie === 'nieuws-van-klaas';
const cat = CATEGORIE_T[taal][kast.categorie];
const naamLabel = label(kast);

// og:image en schema-beelden: echte bestanden met absolute URL (WhatsApp en Google lezen geen srcset).
const og = await getImage({ src: kast.fotos[0].src, width: 1200, format: 'jpg', quality: 68 });
const ogUrl = new URL(og.src, SITE).href;
const schemaBeelden = [ogUrl]; // een groot beeld volstaat voor Google; scheelt honderden extra bestanden

const kruimels = [
  { naam: u.home, pad: lp(taal, '/') },
  { naam: u.collectie, pad: lp(taal, '/webshop/') },
  { naam: cat?.naam ?? u.collectie, pad: lp(taal, `/webshop/cat/${kast.categorie}/`) },
  { naam: kast.code ?? naamLabel, pad: padVan(kast, taal) },
];
// Zonder vertaling geen Product-schema in een taal waarin de tekst niet staat (pagina staat dan ook op noindex).
const schema = [kruimelSchema(kruimels), ...(inspiratie || !vertaald ? [] : [productSchema(kast, schemaBeelden)])];

// Bekijk ook: te-koop-stukken die het meest lijken (zelfde soort woord in de naam, dan zelfde categorie, dan nieuwste).
// Ook op verkochte pagina's, zodat bezoekers uit Google doorlopen naar wat nog wel te koop is. Op de Nederlandse naam.
const SOORTEN = ['vitrine', 'linnen', 'kleding', 'tv', 'side', 'commode', 'dressoir', 'dicht', 'laag', 'lage', 'hoog', 'hoge', 'rek', 'tafel', 'kruk', 'bank', 'lamp', 'kist', 'deur', 'nachtkast', 'badkamer'];
const woorden = (k: Kast) => SOORTEN.filter((w) => k.naam.toLowerCase().includes(w));
const mijn = woorden(kast);
const lijkt = (k: Kast) => woorden(k).filter((w) => mijn.includes(w)).length * 2 + +(k.categorie === kast.categorie);
const meer = kasten
  .filter((k) => k.status === 'te-koop' && k.inCollectie && k.slug !== kast.slug && k.code !== kast.code)
  .sort((a, b) => lijkt(b) - lijkt(a) || b.volgorde - a.volgorde)
  .slice(0, 4);
// 'Bekijk ook'-knop: naar de eigen categorie, Joosje Doodles en sfeerfoto's naar de India kasten.
const verder = ['joosjedoodles', 'inspiratie', 'nieuws-van-klaas'].includes(kast.categorie) ? 'india-kasten' : kast.categorie;
const verderTekst = CATEGORIE_T[taal][verder]?.alle ?? CATEGORIE_T[taal]['india-kasten'].alle;
const wie = T.wie(kast);
const vraag = verkocht ? T.waVerkocht(wie) : T.waVraag(wie);
const id = kast.code ?? kast.slug;
// Hoofdvak van de galerij: vaste verhouding (die van de eerste foto, begrensd), zodat wisselen nooit verspringt.
// Breedte zo dat het vak nooit hoger wordt dan ~78% van het scherm: geen witte vlakken naast een staande foto.
const r = Math.min(1.5, Math.max(0.6, kast.fotos[0].src.width / kast.fotos[0].src.height)).toFixed(3);
const vakStijl = `aspect-ratio:${r};width:min(100%, calc(78vh * ${r}));width:min(100%, calc(78svh * ${r}))`;
// Specificaties alleen uit de gegevens: hout en herkomst alleen als de tekst het zegt of het een India kast is.
const specs: [string, string][] = [
  ...(kast.code ? [[T.spec.nr, kast.code] as [string, string]] : []),
  ...(kast.maten ? [[T.spec.maten, matenT(kast.maten, taal)] as [string, string]] : []),
  [T.spec.soort, cat?.naam ?? ''],
  ...(isTeak(kast) ? [[T.spec.hout, T.spec.teak] as [string, string]] : []),
  ...(['india-kasten', 'indiase-tafels'].includes(kast.categorie) || /india/i.test(kast.naam + kast.omschrijving) ? [[T.spec.herkomst, T.spec.india] as [string, string]] : []),
];
const score = taal === 'en' ? zaak.google.score.replace(',', '.') : zaak.google.score;
const nlLang = !vertaald ? 'nl' : undefined; // Nederlandse tekst op een DE/EN-pagina: zo leest een schermlezer hem goed voor
---
<Basis titel={seoTitel(kast)} beschrijving={seoBeschrijving(kast)} pad={padVan(kast)} taal={taal} ogBeeld={ogUrl} schema={schema} talen={talen} vertalingOntbreekt={!vertaald}>
  <div class="wrap pt-2">
    <nav aria-label={u.kruimelpad} class="pb-6 text-xs text-stil">
      <ol class="flex flex-wrap gap-x-2">
        {kruimels.slice(0, -1).map((k) => <li><a class="no-underline hover:text-inkt" href={k.pad}>{k.naam}</a><span class="ml-2" aria-hidden="true">/</span></li>)}
        <li aria-current="page" class="text-inkt" lang={kast.code ? undefined : nlLang}>{kruimels.at(-1)!.naam}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-start lg:gap-y-8">
      <!-- Rechterkolom (koopkaart) lost op mobiel op, zodat volgorde wordt: foto's, nummer en naam, prijs en knoppen, tekst. -->
      <div class="contents lg:sticky lg:top-28 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:block lg:self-start">
        <div class="order-2 lg:order-none">
          <h1>
            {kast.code && <span class="kastnummer block text-[3rem] text-[#894606] sm:text-[3.75rem] lg:text-[4.25rem]">{kast.code}</span>}
            <span lang={nlLang} class:list={['block hyphens-auto', kast.code ? 'mt-2 font-tekst text-lg font-semibold leading-snug tracking-normal text-inkt sm:mt-3 sm:text-2xl' : 'text-[1.9rem] leading-tight sm:text-5xl sm:leading-[0.98]']}>{naamLabel}</span>
          </h1>
        </div>

        {!inspiratie && (
          <div id="koop" class="order-3 lg:order-none lg:mt-7 lg:rounded-[24px] lg:bg-wit lg:p-7 lg:shadow-zacht lg:ring-1 lg:ring-lijn">
            {!verkocht && <p class="font-kop text-[2.25rem] font-extrabold leading-none tracking-[-0.02em] tabular-nums text-inkt [font-stretch:108%] sm:text-[2.5rem]">{prijsTekst(kast)}</p>}
            {!verkocht && kast.categorie === 'india-kasten' && <p class="mt-2 text-sm text-stil">{T.uniek}</p>}

            <div class:list={[!verkocht && 'mt-6']}>
              {verkocht ? (
                <>
                  <p>{cat?.verkocht ?? CATEGORIE_T[taal]['india-kasten'].verkocht} {T.verkochtRest}</p>
                  <a class="knop knop-geel mt-5 w-full whitespace-normal text-center" href={waLink(vraag)} data-goatcounter-click={`vraag-verkocht-${id}`}>{T.zoek}</a>
                  {meer.length > 0 && <a class="knop knop-wit mt-3 w-full whitespace-normal text-center" href="#bekijk-ook">{T.nuTeKoop}</a>}
                </>
              ) : (
                <>
                  <Reserveer kast={kast} />
                  <a class="knop knop-wit mt-3 w-full" href={waLink(vraag)} data-goatcounter-click={`whatsapp-${id}`}><Icoon naam="wa" />{T.wa}</a>
                  <ul class="mt-5 space-y-2 text-sm">
                    {T.punten.map((p) => <li class="flex gap-2.5"><Icoon naam="vink" class="mt-0.5 h-4 w-4 flex-none text-inkt" />{p}</li>)}
                  </ul>
                </>
              )}
            </div>

            <dl class="mt-6 divide-y divide-lijn border-y border-lijn text-[.95rem]">
              {specs.map(([k, v]) => <div class="flex justify-between gap-4 py-2.5"><dt class="text-stil">{k}</dt><dd class="text-right font-medium text-inkt tabular-nums">{v}</dd></div>)}
            </dl>

            <div class="mt-6 flex items-center gap-4 pt-1">
              <Picture src={klaasFoto} alt={T.klaasAlt} formats={['avif']} fallbackFormat="webp" widths={[112]} sizes="56px" quality={70}
                class="h-14 w-14 flex-none rounded-full object-cover object-[50%_35%]" />
              <div class="text-sm">
                <p class="font-semibold text-inkt">{T.vraagKlaas}</p>
                <p><a class="link" href={zaak.telefoonLink} data-goatcounter-click={`bel-${id}`}>{taal === 'nl' ? zaak.telefoon : '+31 6 26 37 84 80'}</a></p>
              </div>
              <a href={zaak.google.link} rel="noopener" class="ml-auto text-right text-xs text-stil no-underline hover:text-inkt">
                <span class="flex justify-end text-saffraan" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</span>
                <b class="text-inkt">{score}</b> {T.opGoogle} ({zaak.google.aantal})
              </a>
            </div>
          </div>
        )}
      </div>

      <!-- Galerij: grote foto op eigen verhouding, daaronder duimnagels om te wisselen. -->
      <div class="order-1 lg:order-none lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <div class="mx-auto" style={vakStijl.replace(/aspect-ratio:[^;]+;/, '')}>
        <div class="relative overflow-hidden rounded-[24px] bg-wit ring-1 ring-lijn" style={`aspect-ratio:${r}`}>
          {kast.toon.fotos.map((f, i) => (
            <div data-dia={i} class:list={['absolute inset-0', i > 0 && 'hidden']}>
              <Picture src={f.src} alt={f.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 720, 1000, 1400]}
                sizes="(min-width: 1280px) 700px, (min-width: 1024px) 56vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} quality={64}
                class="h-full w-full object-contain" />
            </div>
          ))}
          {verkocht && <span class="absolute left-3 top-3 rounded-full bg-[#a3341f] px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-wit">{u.verkocht}</span>}
        </div>
        {kast.fotos.length > 1 && (
          <div class="mt-3 flex flex-wrap gap-3" role="group" aria-label={u.fotos} data-duimen>
            {kast.toon.fotos.map((f, i) => (
              <button type="button" data-duim={i} aria-label={`${u.toonFoto} ${i + 1}: ${f.alt}`} aria-pressed={i === 0 ? 'true' : 'false'}
                class="h-20 w-20 overflow-hidden rounded-xl ring-1 ring-lijn transition aria-pressed:ring-2 aria-pressed:ring-inkt sm:h-24 sm:w-24">
                <Picture src={f.src} alt="" formats={['avif']} fallbackFormat="webp" widths={[200]} sizes="96px" quality={60} class="h-full w-full object-cover" />
              </button>
            ))}
          </div>
        )}
        </div>
      </div>

      <div class="order-4 lg:order-none lg:col-span-7 lg:col-start-1 lg:row-start-2">
        {kast.toon.omschrijving && (
          <section class="mt-2 max-w-2xl" aria-labelledby="omschrijving">
            <h2 id="omschrijving" class="text-2xl">{cat?.over ?? CATEGORIE_T[taal]['india-kasten'].over}</h2>
            {!vertaald && <p class="mt-3 text-sm text-stil">{u.alleenNl}</p>}
            <div class="verhaal mt-4" lang={nlLang} set:html={kast.toon.omschrijving} />
          </section>
        )}
        <div class="mt-10 max-w-2xl rounded-[18px] p-5 text-sm ring-1 ring-lijn sm:p-6">
          <p class="font-semibold text-inkt">{T.komKijken}</p>
          <p class="mt-1">{zaak.straat}, {zaak.postcode} {zaak.plaats}. {T.parkeren}</p>
          <p class="mt-1 tabular-nums">{T.tijden(tijden)}</p>
        </div>
        {!inspiratie && kast.categorie === 'india-kasten' && (
          <p class="mt-6 text-sm text-stil">{T.kleur}</p>
        )}
      </div>
    </div>
  </div>

  {meer.length > 0 && (
    <section id="bekijk-ook" class="wrap mt-14 scroll-mt-28 sm:mt-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl">{verkocht ? T.zelfdeLijn : T.ookKijken}</h2>
        <a class="knop knop-wit" href={lp(taal, `/webshop/cat/${verder}/`)}>{verderTekst}</a>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-4">
        {meer.map((k) => <KastKaart kast={k} />)}
      </ul>
    </section>
  )}

</Basis>

<script>
  const dias = [...document.querySelectorAll<HTMLElement>('[data-dia]')];
  const duimen = [...document.querySelectorAll<HTMLButtonElement>('[data-duim]')];
  // Het hoofdvak heeft een vaste maat: wisselen verandert alleen welke foto zichtbaar is, nooit de hoogte.
  const toon = (b: HTMLButtonElement) => {
    const i = b.dataset.duim;
    dias.forEach((d) => d.classList.toggle('hidden', d.dataset.dia !== i));
    duimen.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  };
  duimen.forEach((b, n) => {
    b.addEventListener('click', () => toon(b));
    // Pijltjestoetsen tussen de duimnagels.
    b.addEventListener('keydown', (e) => {
      const stap = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!stap) return;
      e.preventDefault();
      const v = duimen[(n + stap + duimen.length) % duimen.length];
      v.focus({ preventScroll: true });
      toon(v);
    });
  });
  // Na het laden de overige foto's alvast ophalen, zodat er bij wisselen geen leeg vak verschijnt.
  addEventListener('load', () => dias.forEach((d) => d.querySelectorAll('img').forEach((img) => { img.loading = 'eager'; })), { once: true });
</script>
