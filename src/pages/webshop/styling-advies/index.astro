---
import { Picture } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import PaginaKop from '../../../components/PaginaKop.astro';
import { kruimelSchema } from '../../../lib/kasten';
import { zaak, waLink } from '../../../lib/site';
import styling from '../../../assets/site/styling.jpg';
// De oude pagina had alleen de kop "STYLING advies" en deze foto. Geen tekst verzonnen; alleen de weg naar Klaas.
---
<Basis
  titel="Styling advies | Kast van Klaas Leiden"
  beschrijving="Styling advies bij Kast van Klaas: oude meubels uit India in jouw interieur. Kom langs op de Kaasmarkt in Leiden of vraag het Klaas."
  pad="/webshop/styling-advies/"
  schema={[kruimelSchema([{ naam: 'Home', pad: '/' }, { naam: 'Styling advies', pad: '/webshop/styling-advies/' }])]}
>
  <PaginaKop kruimel="Styling advies" titel="Styling advies" />
  <section class="wrap mt-14 grid gap-10 md:grid-cols-12 md:gap-14">
    <figure class="md:col-span-6">
      <Picture src={styling} alt="Twee houten stoelen en een gedekte tafel op een binnenplaats onder een boom" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 48vw, 100vw" quality={72} loading="eager" class="h-auto w-full rounded-[24px]" />
    </figure>
    <div class="md:col-span-5 md:col-start-8 md:self-end">
      <p class="text-lg leading-relaxed">Wil je weten hoe een kast of tafel uit India staat in jouw huis? Kom langs in de winkel op de Kaasmarkt, of stuur Klaas een bericht.</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a class="knop" href={waLink('Hallo Klaas, ik wil graag styling advies.')} data-goatcounter-click="whatsapp-styling">Vraag Klaas</a>
        <a class="link" href={zaak.telefoonLink} data-goatcounter-click="bel-styling">{zaak.telefoon}</a>
      </div>
    </div>
  </section>
</Basis>
