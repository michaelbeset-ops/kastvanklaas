---
// Soortpagina's op de oude tag-URL's, alleen voor soorten met genoeg kasten (zie src/lib/soorten.mjs).
import Soort from '../../../views/Soort.astro';
import { soortenMetPagina } from '../../../lib/soorten.mjs';
export function getStaticPaths() {
  return soortenMetPagina().map((s) => ({ params: { tag: s.tag } }));
}
---
<Soort taal="nl" tag={Astro.params.tag as string} />
