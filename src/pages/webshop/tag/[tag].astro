---
// Soortpagina's op de oude tag-URL's, alleen voor soorten met genoeg kasten (zie src/lib/soorten.mjs).
import { getImage } from 'astro:assets';
import Basis from '../../../layouts/Basis.astro';
import Collectie from '../../../components/Collectie.astro';
import { alleKasten, kruimelSchema } from '../../../lib/kasten';
import { SITE } from '../../../lib/site';
import { soortenMetPagina, hoortBij, soortChips } from '../../../lib/soorten.mjs';

export function getStaticPaths() {
  return soortenMetPagina().map((s) => ({ params: { tag: s.tag }, props: { tag: s.tag } }));
}
const { tag } = Astro.props as { tag: string };
const echte = soortenMetPagina();
const soort = echte.find((s) => s.tag === tag)!;
const alle = (await alleKasten()).filter((k) => k.inCollectie);
const kasten = alle.filter((k) => hoortBij(soort, k));
const n = kasten.filter((k) => k.status === 'te-koop').length;
const pad = `/webshop/tag/${tag}/`;
const kruimels = [{ naam: 'Home', pad: '/' }, { naam: 'Collectie', pad: '/webshop/' }, { naam: soort.meervoud, pad }];
const chips = soortChips(alle, new Set(echte.map((s) => s.tag)));
const intro = `${soort.meervoud} uit India, zestig tot honderd jaar oud en van primair teakhout. Klaas zoekt elke kast zelf uit, dus er is er telkens maar één van. Bovenaan wat nu te koop is, daaronder wat al verkocht is.`;
const eerste = kasten.find((k) => k.status === 'te-koop') ?? kasten[0];
const og = new URL((await getImage({ src: eerste.fotos[0].src, width: 1200, format: 'jpg', quality: 68 })).src, SITE).href;
---
<Basis
  titel={`${soort.meervoud} uit India, oud teakhout | Kast van Klaas Leiden`}
  beschrijving={`${n ? `${n} ${soort.meervoud.toLowerCase()} te koop` : soort.meervoud} uit India: oud, van teakhout en elk met een eigen kastnummer. Te zien bij Kast van Klaas op de Kaasmarkt in Leiden.`}
  pad={pad}
  ogBeeld={og}
  schema={[kruimelSchema(kruimels)]}
>
  <Collectie kasten={kasten} actief="india-kasten" titel={`${soort.meervoud} uit India`} intro={intro} kruimels={kruimels} soorten={chips} huidigPad={pad} />
</Basis>
