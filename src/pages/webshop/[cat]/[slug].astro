---
import KastPagina from '../../../views/Kast.astro';
import { alleKasten } from '../../../lib/kasten';
export async function getStaticPaths() {
  return (await alleKasten('nl')).map((k) => ({ params: { cat: k.categorie, slug: k.slug } }));
}
---
<KastPagina taal="nl" slug={Astro.params.slug as string} />
