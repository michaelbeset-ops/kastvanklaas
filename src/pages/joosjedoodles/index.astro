---
import { Picture } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import KastKaart from '../../components/KastKaart.astro';
import { alleKasten, kruimelSchema } from '../../lib/kasten';
import kikker from '../../assets/site/kikker.jpg';
// Klein houden (afspraak met Michael): "Ook in de winkel". Titel en beeld komen van de oude JoosjeDoodles-pagina's.
const werk = (await alleKasten()).filter((k) => k.categorie === 'joosjedoodles' && !/kast|tafel|kookeiland|lamp|rek/i.test(k.naam));
---
<Basis
  titel="Joosje Doodles, illustratie en ontwerp | Kast van Klaas Leiden"
  beschrijving="Ook in de winkel van Kast van Klaas op de Kaasmarkt in Leiden: illustratie en ontwerp van JoosjeDoodles."
  pad="/joosjedoodles/"
  schema={[kruimelSchema([{ naam: 'Home', pad: '/' }, { naam: 'Joosje Doodles', pad: '/joosjedoodles/' }])]}
>
  <PaginaKop kruimel="Joosje Doodles" titel="Illustratie en ontwerp JoosjeDoodles" intro="Ook in de winkel op de Kaasmarkt." />
  <section class="wrap mt-14 grid gap-10 md:grid-cols-12 md:gap-14">
    <figure class="md:col-span-4">
      <Picture src={kikker} alt="Illustratie van JoosjeDoodles: een kikker die uitrust onder een grote madelief" formats={['avif']} fallbackFormat="webp" widths={[400, 700]}
        sizes="(min-width: 768px) 32vw, 100vw" quality={78} loading="eager" class="h-auto w-full rounded-[24px]" />
    </figure>
    <div class="md:col-span-7 md:col-start-6">
      <h2 class="text-2xl sm:text-3xl">In de winkel</h2>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3">
        {werk.map((k) => <KastKaart kast={k} />)}
      </ul>
      <p class="mt-10"><a class="link" href="/webshop/cat/joosjedoodles/">Alles van Joosje Doodles</a></p>
    </div>
  </section>
</Basis>
