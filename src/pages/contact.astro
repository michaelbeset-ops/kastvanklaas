---
import { Picture, getImage } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Aanvraag from '../components/Aanvraag.astro';
import Tijden from '../components/Tijden.astro';
import Icoon from '../components/Icoon.astro';
import { kruimelSchema, winkelSchema } from '../lib/kasten';
import { zaak, SITE, waLink } from '../lib/site';
import pui from '../assets/site/pui.jpg';
import hero from '../assets/site/hero.jpg';

const winkelBeeld = new URL((await getImage({ src: hero, width: 1170, format: 'jpg' })).src, SITE).href;
// Alleen een link naar Google Maps, geen ingesloten kaart: dan plaatst de site geen cookies van derden.
const route = 'https://www.google.com/maps/dir/?api=1&destination=Kaasmarkt+3%2C+2312+HZ+Leiden';
---
<Basis
  titel="Contact en openingstijden | Kast van Klaas, Kaasmarkt 3 Leiden"
  beschrijving="Kast van Klaas, Kaasmarkt 3 in Leiden. Open maandag tot en met zondag, of op afspraak. Parkeren voor de deur. Bel 06-26378480 of mail klaas@kastvanklaas.nl."
  pad="/contact/"
  schema={[winkelSchema(winkelBeeld), kruimelSchema([{ naam: 'Home', pad: '/' }, { naam: 'Contact', pad: '/contact/' }])]}
>
  <PaginaKop kruimel="Contact" titel="Contact Klaas" />

  <!-- Links de winkel groot met adres en route, rechts direct contact en de openingstijden. -->
  <section class="wrap mt-12 grid gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="relative overflow-hidden rounded-[24px] shadow-zacht lg:col-span-7">
      <Picture src={pui} alt="De ingang van de winkel van Kast van Klaas, met groene tuinstoelen voor de deur" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 58vw, 100vw" quality={72} loading="eager" class="aspect-[4/5] h-full w-full object-cover sm:aspect-[4/3] lg:aspect-auto" />
      <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(180deg,#1f181200,#1f1812e6_55%)] p-6 pt-24 sm:p-9 sm:pt-32">
        <p class="kicker text-saffraan">De winkel</p>
        <p class="mt-3 font-kop text-[1.75rem] font-extrabold leading-tight text-wit [font-stretch:110%] sm:text-[2.1rem]">{zaak.straat}<br />{zaak.postcode} {zaak.plaats}</p>
        <p class="mt-3 max-w-md text-wit/85">Achter de Hooigracht, hoogte Oude Rijn. {zaak.parkeren}</p>
        <a href={route} rel="noopener" class="knop knop-geel mt-6" data-goatcounter-click="route-contact">Plan route<Icoon naam="pijl" /></a>
      </div>
    </div>

    <div class="flex flex-col gap-6 lg:col-span-5">
      <div class="kaart p-6 sm:p-7">
        <h2 class="text-xl">Bel, app of mail Klaas</h2>
        <a href={zaak.telefoonLink} class="mt-4 block font-kop text-[2.1rem] font-extrabold leading-none text-inkt no-underline tabular-nums [font-stretch:110%] hover:text-teak-donker sm:text-[2.5rem]" data-goatcounter-click="bel-contact">{zaak.telefoon}</a>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={waLink('Hallo Klaas, ')} class="knop knop-geel" data-goatcounter-click="whatsapp-contact"><Icoon naam="wa" />WhatsApp</a>
          <a href={`mailto:${zaak.email}`} class="knop knop-wit">Mail</a>
        </div>
        <p class="mt-4 text-sm text-stil">{zaak.email}</p>
      </div>
      <Tijden />
      <p class="px-1 text-xs text-stil">Kast van Klaas · KvK {zaak.kvk}</p>
    </div>
  </section>

  <Aanvraag bron="contact" />
</Basis>
