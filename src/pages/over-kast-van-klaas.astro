---
import { Picture } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import { kruimelSchema } from '../lib/kasten';
import { waLink } from '../lib/site';
import klaas from '../assets/site/klaas.jpg';
import klaasIndia from '../assets/site/klaas-india.jpg';
import binnen from '../assets/site/winkel.jpg';
import indiaWerkplaats from '../assets/site/india-werkplaats.jpg';
import indiaDeuren from '../assets/site/india-deuren.jpg';
import indiaBlikjes from '../assets/site/india-blikjes.jpg';
// Alle tekst letterlijk van kastvanklaas.nl/over-kast-van-klaas/ en de home (bron/site), alleen ingekort.
---
<Basis
  titel="Over Klaas Hoekstra en zijn India kasten | Kast van Klaas"
  beschrijving="Klaas Hoekstra reist al ruim twintig jaar naar Noord-India om zelf de mooiste oude kasten van primair teakhout te zoeken. Winkel op de Kaasmarkt in Leiden."
  pad="/over-kast-van-klaas/"
  schema={[kruimelSchema([{ naam: 'Home', pad: '/' }, { naam: 'Over Kast van Klaas', pad: '/over-kast-van-klaas/' }])]}
>
  <!-- Bovenaan donker, zoals de home: Klaas groot in beeld met de kop. -->
  <section class="donker bg-nacht pb-14 pt-4 text-mist sm:pb-20 sm:pt-6 lg:pb-24">
    <div class="wrap">
      <nav aria-label="Kruimelpad" class="text-xs text-mist">
        <ol class="flex flex-wrap gap-x-2">
          <li><a class="no-underline hover:text-wit" href="/">Home</a><span class="ml-2" aria-hidden="true">/</span></li>
          <li aria-current="page" class="text-wit">Over Kast van Klaas</li>
        </ol>
      </nav>
      <div class="mt-8 grid gap-10 md:grid-cols-12 md:items-center md:gap-14 lg:mt-10">
        <div class="md:col-span-7 lg:col-span-6">
          <h1 class="text-[2.1rem] text-wit min-[400px]:text-[2.4rem] sm:text-5xl lg:text-[4.25rem]">Authentieke Indiase meubels van <span class="sier text-saffraan">teakhout</span></h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-wit/90 sm:text-xl">In het hartje van Leiden, op de Kaasmarkt, vindt u de winkel Kast van Klaas. Een eigenzinnige winkel met unieke, rechtstreeks uit India geïmporteerde, oude India kasten.</p>
        </div>
        <figure class="md:col-span-5 lg:col-span-5 lg:col-start-8">
          <Picture src={klaas} alt="Portret van Klaas Hoekstra, eigenaar van Kast van Klaas" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 40vw, 100vw" quality={74} loading="eager" fetchpriority="high" class="aspect-[4/5] w-full rounded-[24px] object-cover object-[50%_30%]" />
          <figcaption class="mt-2 text-xs text-mist">Klaas Hoekstra</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Zijn verhaal, letterlijk van de huidige site, in een prettige leesbreedte. -->
  <section class="wrap py-14 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-2xl space-y-5 text-lg leading-relaxed">
      <p>Eigenaar Klaas Hoekstra en zijn team bieden een buitengewone collectie authentieke meubels in alle soorten en maten, uitgevoerd in prachtige Indiase kleuren.</p>
      <p>Klaas kent Noord-India als geen ander. Het is dan ook al meer dan twintig jaar zijn geliefde bestemming, waar hij enkele keren per jaar naartoe reist om persoonlijk op zoek te gaan naar de mooiste Indiase kasten. Originaliteit staat voorop.</p>
      <p>De kasten zijn veelal minimaal zestig tot meer dan honderd jaar oud en zijn nog gemaakt van zogenoemd primair teakhout, dat tegenwoordig steeds zeldzamer is.</p>
    </div>
    <!-- Strook uit India: dezelfde eigen foto's als op de home. -->
    <div class="mt-14 grid grid-cols-2 gap-3 sm:mt-20 sm:grid-cols-12 sm:gap-4">
      <div class="col-span-2 sm:col-span-6">
        <Picture src={indiaWerkplaats} alt="Indiase meubelmakers in een werkplaats, voor gerestaureerde vitrinekasten" formats={['avif']} fallbackFormat="webp" widths={[480, 960]}
          sizes="(min-width: 640px) 50vw, 100vw" quality={64} loading="lazy" class="aspect-[4/3] h-full w-full rounded-[18px] object-cover" />
      </div>
      <div class="sm:col-span-3">
        <Picture src={indiaDeuren} alt="Oude Indiase deuren en kasten, opgesteld in de winkel" formats={['avif']} fallbackFormat="webp" widths={[400, 800]}
          sizes="(min-width: 640px) 25vw, 50vw" quality={64} loading="lazy" class="aspect-[3/4] h-full w-full rounded-[18px] object-cover" />
      </div>
      <div class="sm:col-span-3">
        <Picture src={indiaBlikjes} alt="Oude Indiase blikjes met handgeschilderde opdruk" formats={['avif']} fallbackFormat="webp" widths={[400, 800]}
          sizes="(min-width: 640px) 25vw, 50vw" quality={64} loading="lazy" class="aspect-[3/4] h-full w-full rounded-[18px] object-cover" />
      </div>
    </div>
  </section>

  <section class="donker bg-nacht py-14 text-mist sm:py-20 lg:py-28">
    <div class="wrap grid gap-10 md:grid-cols-12 md:items-center md:gap-14">
      <div class="md:col-span-5">
        <h2 class="text-3xl text-wit md:text-[1.8rem] lg:text-[2.6rem]">Direct uit India <span class="text-saffraan">geïmporteerd.</span></h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed">
          <p>Onder toezicht van Klaas en zijn medewerkers worden de oude India kasten, indien nodig, bij lokale Indiase meubelmakers tot in detail gerestaureerd voordat ze naar Nederland worden verscheept.</p>
          <p>De Kasten van Klaas zijn unieke exemplaren, eigenhandig geïmporteerd uit India.</p>
        </div>
      </div>
      <figure class="md:col-span-7">
        <Picture src={klaasIndia} alt="Klaas Hoekstra voor een verweerde roze muur" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 55vw, 100vw" quality={72} class="h-auto w-full rounded-[24px]" />
      </figure>
    </div>
  </section>

  <section class="wrap grid gap-10 pt-14 sm:pt-20 md:grid-cols-12 md:gap-14 lg:pt-28">
    <figure class="md:col-span-6">
      <Picture src={binnen} alt="Vitrinekasten en een oude tafel in de winkel van Kast van Klaas" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1170]}
        sizes="(min-width: 768px) 50vw, 100vw" quality={72} class="h-auto w-full rounded-[24px]" />
    </figure>
    <div class="md:col-span-5 md:col-start-8 md:self-center">
      <h2 class="text-3xl">Op zoek naar een oude kast op maat?</h2>
      <p class="mt-6 text-lg leading-relaxed">In overleg kunt u een eigen maatwerkkast laten maken, gemaakt van authentiek Indiaas (sloop)hout.</p>
      <a href={waLink('Hallo Klaas, ik zoek een kast op maat.')} class="knop mt-8" data-goatcounter-click="whatsapp-over">Vraag Klaas naar maatwerk</a>
    </div>
  </section>
</Basis>
